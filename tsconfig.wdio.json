{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"lib": ["ES2020"],
		"moduleResolution": "node",
		"esModuleInterop": true,
		"strict": true,
		"outDir": "out/wdio",
		"types": [
			"node",
			"webdriverio/async",
			"@wdio/mocha-framework",
